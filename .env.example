# Copie este arquivo para .env e ajuste conforme o seu ambiente

# Porta HTTP em que a API Spring Boot será aberta ao ser executada
SERVER_PORT=8080

# Configuração do banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=defaultdb
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_aqui
DB_SSLMODE=require
DB_POOL_MAX_SIZE=10

# Origens permitidas para requisições CORS (use * ou informe ex: http://localhost:5173)
CORS_ALLOWED_ORIGINS=*

# Se true, popula os lançamentos iniciais de exemplo automaticamente caso a tabela esteja vazia
APP_SEED_ON_EMPTY=false
